{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miss Americana",
  "version": "0.1.0",
  "identifier": "com.miss-americana-app.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "miss-americana-app",
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/ytsearch.exe"
    ]
  }
}
