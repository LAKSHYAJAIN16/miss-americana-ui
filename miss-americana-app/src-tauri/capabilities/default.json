{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    {
      "identifier": "fs:write-all",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    {
      "identifier": "fs:read-all",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.youtube.com"
        },
        {
          "url": "http://localhost"
        },
        {
          "url": "https://rr2---sn-jvbxjv-tihz.googlevideo.com"
        },
        {
          "url": "https://*.googlevideo.com"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ytsearch",
          "sidecar": true,
          "args": [
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/innersearch",
          "sidecar": true,
          "args": [
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    "shell:allow-open",
    "fs:default",
    "http:default",
    "shell:default"
  ]
}
