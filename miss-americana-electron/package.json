{
  "name": "miss-americana",
  "productName": "Miss Americana",
  "version": "0.1.0",
  "description": "Miss Americana Music Player",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "build": "vite build --config vite.electron.config.js",
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "vite build --config vite.electron.config.js",
    "package": "npm run build:renderer && npm run build:main && electron-forge package",
    "make": "npm run build:renderer && npm run build:main && electron-forge make",
    "watch:main": "webpack --watch --config webpack.main.config.js",
    "watch:renderer": "vite build --config vite.electron.config.js --watch",
    "dev": "cross-env NODE_ENV=development node scripts/dev.js",
    "preview": "vite preview --port 1420",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .js,.jsx .",
    "postinstall": "node scripts/postinstall.js && electron-builder install-app-deps"
  },
  "keywords": [],
  "author": {
    "name": "LAKSHYAJAIN16",
    "email": "minecraftpogtechno@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@electron-forge/cli": "^7.8.2",
    "@electron-forge/maker-deb": "^7.8.2",
    "@electron-forge/maker-rpm": "^7.8.2",
    "@electron-forge/maker-squirrel": "^7.8.2",
    "@electron-forge/maker-zip": "^7.8.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.2",
    "@electron-forge/plugin-fuses": "^7.8.2",
    "@electron-forge/plugin-webpack": "^7.8.2",
    "@electron/fuses": "^2.0.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.17",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^28.1.4",
    "electron-reload": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.12",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^7.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "axios": "^1.9.0",
    "color": "^5.0.0",
    "color.js": "^1.2.0",
    "dashjs": "^5.0.3",
    "dotenv": "^16.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "js-cookie": "^3.0.5",
    "lrclib-api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.6.1",
    "react-spotify-auth": "^1.4.3",
